# Copier en .env.production sur le VPS, puis compléter.
# .env* est ignoré par git : ce fichier ne doit jamais être commité.

# --- Domaine et certificat ---
DOMAIN=anasshilama.com
ACME_EMAIL=hilama.anas@gmail.com

# --- Formulaire de contact (Resend) ---
# Sans ces valeurs le site tourne, mais le formulaire renvoie son erreur.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hilama.anas@gmail.com
CONTACT_FROM_EMAIL=contact@anasshilama.com
